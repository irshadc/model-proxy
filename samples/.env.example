# Copy into a sample folder as .env, e.g. cp .env.example strands-agent/.env
# Values: output of backend/scripts/get-api-key.sh
PROXY_BASE_URL=https://dxxxxxxxxxxxxx.cloudfront.net/v1
PROXY_API_KEY=your-api-gateway-key

# Optional: full Bedrock model / inference profile ID; must be in the stack's AllowedModelIds
# MODEL_ID=global.openai.gpt-6-luna

# Optional: none | low | medium | high | xhigh | max (default: low)
# REASONING_EFFORT=low
